# Copy to .env.local to change how the dashboard gets its data.
#   mock = built-in sample data (default, works without the Go API)
#   live = real warehouse results from the Go API through the /api proxy
VITE_API_MODE=mock

# Where the Vite dev proxy forwards /api (default http://localhost:8080).
# The docker compose `web` service sets this to http://api:8080 for you.
# API_TARGET=http://localhost:8080
