# Optional overrides for the Go API. Copy to olap-backend/.env (or set them in
# the repository-root .env). Every value is optional: the defaults below target
# the Docker Compose warehouse on localhost:5434. When the API runs through
# `docker compose --profile app`, the compose file supplies these for you, so
# this file is only needed when you run `go run .` yourself.

API_PORT=8080
DW_HOST=localhost
DW_PORT=5434
DW_DB=dw_db
DW_USER=postgres
DW_PASSWORD=postgres
DW_SSLMODE=disable
QUERY_TIMEOUT=60s
DW_MAX_CONNS=8
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Report SQL directory. Leave unset to auto-detect (../olap/queries, then
# olap/queries relative to the working directory).
# OLAP_QUERIES_DIR=
