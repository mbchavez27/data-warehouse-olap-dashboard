# Copy once per machine: `cp .env.example .env` (the copy is gitignored).
# Read by Docker Compose (source_db, dw_db, and the `app` profile that runs the
# API and dashboard) and sourced by the db/scripts and etl wrappers.

SOURCE_PORT=5433
SOURCE_DB=source_db
SOURCE_USER=postgres
SOURCE_PASSWORD=postgres

DW_PORT=5434
DW_DB=dw_db
DW_USER=postgres
DW_PASSWORD=postgres
